# Base du référentiel (séparée du CDM)
DATABASE_URL=postgresql+psycopg://omop:omop@localhost:5432/omop_referentiel
# Base de test : son schéma est recréé à chaque session pytest
TEST_DATABASE_URL=postgresql+psycopg://omop:omop@localhost:5432/omop_referentiel_test
# Répertoire de stockage des fichiers importés entre les étapes de l'assistant
UPLOAD_DIR=var/uploads
# Export « properties » écrit sur le serveur : <EXPORT_DIR>/<PROPERTIES_SUBDIR>/<Domaine>.properties
EXPORT_DIR=data
PROPERTIES_SUBDIR=30_properties
LOG_LEVEL=INFO
